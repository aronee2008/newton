    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/localize": "^22.1.0",
    "jsdom": "^28.1.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
