<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApiContract>..\contracts\newton-catalog.openapi.yaml</ApiContract>
    <GeneratedApi>Generated\NewtonCatalogApi.g.cs</GeneratedApi>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="NSwag.MSBuild" Version="14.7.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(ApiContract)" Link="openapi.yaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Generated at build and not committed: the default *.cs glob would miss it on a fresh clone, so it is listed explicitly. -->
    <Compile Remove="Generated\**" />
    <Compile Include="$(GeneratedApi)" />
  </ItemGroup>

  <Target Name="GenerateApiFromContract" BeforeTargets="CoreCompile" Inputs="$(ApiContract);nswag.json" Outputs="$(GeneratedApi)">
    <Exec Command="$(NSwagExe_Net100) run nswag.json" />
  </Target>

</Project>
