{
  "runtime": "Net100",
  "documentGenerator": {
    "fromDocument": {
      "url": "../contracts/newton-catalog.openapi.yaml"
    }
  },
  "codeGenerators": {
    "openApiToCSharpController": {
      "controllerStyle": "Abstract",
      "useActionResultType": true,
      "useCancellationToken": true,
      "namespace": "NewtonCatalog.Api.Generated",
      "jsonLibrary": "SystemTextJson",
      "dateType": "System.DateOnly",
      "generateNullableReferenceTypes": true,
      "excludedTypeNames": ["ProblemDetails", "ValidationProblemDetails"],
      "output": "Generated/NewtonCatalogApi.g.cs"
    }
  }
}
